-- optional visual toggles
local states = {
    ESP = false,
    NOCLIP = false,
    AUTOFARM = false
}

local function setBtnText(btn, key)
    if key == "ESP" then
        btn.Text = states.ESP and "ESP: ON" or "ESP: OFF"
    elseif key == "NOCLIP" then
        btn.Text = states.NOCLIP and "NOCLIP: ON" or "NOCLIP: OFF"
    elseif key == "AUTOFARM" then
        btn.Text = states.AUTOFARM and "AUTOFARM: ON" or "AUTOFARM: OFF"
    end
end

EspBtn.MouseButton1Click:Connect(function()
    states.ESP = not states.ESP
    setBtnText(EspBtn, "ESP")
end)

NoclipBtn.MouseButton1Click:Connect(function()
    states.NOCLIP = not states.NOCLIP
    setBtnText(NoclipBtn, "NOCLIP")
end)

AutofarmBtn.MouseButton1Click:Connect(function()
    states.AUTOFARM = not states.AUTOFARM
    setBtnText(AutofarmBtn, "AUTOFARM")
end)
