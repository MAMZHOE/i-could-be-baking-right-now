-- ===== ESP UPDATE LOOP =====
RunService.Heartbeat:Connect(function()
    if EspEnabled then
        -- Add ESP to enemies/monsters
        local workspace = game:GetService("Workspace")
        if workspace:FindFirstChild("Mobs") then
            for _, mob in pairs(workspace.Mobs:GetChildren()) do
                addESP(mob, mob.Name)
            end
        end
    end
end)

-- ===== AUTO SKILL CHECK =====
local function setupSkillCheck()
    local replicatedStorage = game:GetService("ReplicatedStorage")
    if replicatedStorage:FindFirstChild("Events") then
        local events = replicatedStorage.Events
        if events:FindFirstChild("SkillCheckUpdate") then
            events.SkillCheckUpdate.OnClientInvoke = function()
                return "Supercomplete"
            end
        end
    end
end

setupSkillCheck(true)
