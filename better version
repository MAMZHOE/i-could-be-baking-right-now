-- Button maker
local function makeButton(label, y)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 50)
    btn.Position = UDim2.new(0.05, 0, 0, y)
    btn.Text = label
    btn.Font = Enum.Font.GothamBlack
    btn.TextScaled = true
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.BorderSizePixel = 2
    btn.BorderColor3 = Color3.fromRGB(0, 255, 136)
    btn.AutoButtonColor = false
    btn.Parent = ContentFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    -- Hover effect
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    end)

    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end)

    return btn
end

local ToggleA = makeButton("ESP: OFF", 20)
local ToggleB = makeButton("NOCLIP: OFF", 85)
local ToggleC = makeButton("AUTOFARM: OFF", 150)

local states = {
    A = false,
    B = false,
    C = false
}

local function updateButton(btn, key)
    btn.Text = (key == "A" and "ESP: " or (key == "B" and "NOCLIP: " or "AUTOFARM: ")) .. (states[key] and "ON" or "OFF")
end

-- Toggle window visibility
WindowBtn.MouseButton1Click:Connect(function()
    MainWindow.Visible = not MainWindow.Visible
end)

CloseBtn.MouseButton1Click:Connect(function()
    MainWindow.Visible = false
end)

-- Button functionality
ToggleA.MouseButton1Click:Connect(function()
    states.A = not states.A
    updateButton(ToggleA, "A")
end)

ToggleB.MouseButton1Click:Connect(function()
    states.B = not states.B
    updateButton(ToggleB, "B")
end)

ToggleC.MouseButton1Click:Connect(function()
    states.C = not states.C
    updateButton(ToggleC, "C")
end)
