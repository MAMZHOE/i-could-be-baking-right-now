-- ===== AUTO SKILL CHECK =====
local skillCheckEvent = game:GetService("ReplicatedStorage"):FindFirstChild("Events")
if skillCheckEvent then
    local skillUpdate = skillCheckEvent:FindFirstChild("SkillCheckUpdate")
    if skillUpdate then
        skillUpdate.OnClientInvoke = function()
            return "Supercomplete"
        end
    end
end

